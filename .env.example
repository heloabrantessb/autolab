# Django Settings
DJANGO_SECRET_KEY=django-insecure-chave-de-desenvolvimento-local-autolab
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database (deixe vazio para SQLite local)
DATABASE_URL=

# Armazenamento e Retencao de Resultados Temporarios
RESULTS_ROOT=./var/results
RESULT_TTL_MINUTES=30

# Limites de Processamento de Arquivos ZIP
MAX_ZIP_UPLOAD_BYTES=10485760
MAX_ZIP_ENTRIES=100
MAX_ZIP_UNCOMPRESSED_BYTES=52428800
MAX_ZIP_ENTRY_BYTES=10485760

# Limites de Processamento de Planilhas
MAX_SPREADSHEET_UPLOAD_BYTES=20971520
MAX_SPREADSHEET_ROWS=10000
MAX_SPREADSHEET_COLUMNS=30

# Integracao com IA (desativada por padrao no MVP)
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=

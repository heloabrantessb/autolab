{
  "name": "AutoLab — Python 3.12",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": ["bash", ".devcontainer/setup.sh"],
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AutoLab — desenvolvimento",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "LLM_ENABLED": "false"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    },
    "codespaces": {
      "openFiles": [
        "codespaces_exercises/arquivos/README.md",
        "codespaces_exercises/arquivos/starter.py"
      ]
    }
  }
}
